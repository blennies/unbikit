{
  "name": "unbikit",
  "version": "0.10.5",
  "description": "Decoder for .bik (Bink) video files.",
  "keywords": [
    "audio",
    "bik",
    "bink",
    "codec",
    "decoder",
    "decompress",
    "games",
    "media",
    "player",
    "video"
  ],
  "homepage": "https://blennies.github.io/unbikit",
  "bugs": {
    "url": "https://github.com/blennies/unbikit/issues"
  },
  "license": "(MIT OR Apache-2.0)",
  "author": "Blennies <blennies.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blennies/unbikit.git"
  },
  "files": [
    "dist/**/*.d.cts",
    "dist/**/*.d.ts",
    "dist/**/*.cjs",
    "dist/**/*.js"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/unbikit.js",
  "types": "./dist/unbikit.d.ts",
  "exports": {
    ".": {
      "types": "./dist/unbikit.d.ts",
      "development": "./src/bik-decoder.ts",
      "default": "./dist/unbikit.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/unbikit.d.ts",
        "default": "./dist/unbikit.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "dev:app": "astro dev",
    "build": "tsdown --config-loader unrun --logLevel=info",
    "build:app": "astro build",
    "check": "oxfmt --check && prettier --ignore-path .gitignore --ignore-path .prettierignore-only -c . && oxlint && vitest run --testTimeout 10000",
    "ci:check": "oxfmt --check && prettier --ignore-path .prettierignore-only -c . && oxlint",
    "fix": "oxfmt && prettier --ignore-path .prettierignore-only -w . && oxlint --fix",
    "preview": "astro preview",
    "preview:app": "astro preview",
    "test": "vitest --ui --testTimeout 10000",
    "test:coverage": "vitest --ui --coverage --testTimeout 20000",
    "test:cli": "vitest --testTimeout 10000",
    "ci:test": "vitest run --coverage --testTimeout 30000",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.3.1",
    "@astrojs/mdx": "7.0.4",
    "@astrojs/starlight": "0.41.4",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@fontsource-variable/sora": "5.3.0",
    "@types/audioworklet": "0.0.100",
    "@types/node": "26.1.2",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "astro": "7.1.4",
    "commitlint": "21.2.1",
    "globals": "17.8.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "publint": "0.3.22",
    "rollup-plugin-esbuild": "6.2.1",
    "sharp": "0.35.3",
    "starlight-package-managers": "0.12.0",
    "starlight-theme-rapide": "0.5.2",
    "starlight-typedoc": "0.23.0",
    "ts-extras": "1.3.0",
    "tsdown": "0.22.14",
    "type-fest": "5.8.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "catalog:",
    "unplugin-unused": "0.6.0",
    "unrun": "0.3.1",
    "vite": "catalog:",
    "vitest": "4.1.10"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
